      "name": "Fold Quest"
    }
  ],
  "body": "<p>Start with a square of paper and turn it into a heart, a penguin, and a crane. Each level starts with a fresh sheet.</p>\n<section id=\"fold-quest\" class=\"related-experience\" hidden>\n<p id=\"fold-progress\"></p><h2 id=\"fold-goal\" tabindex=\"-1\">Fold a heart</h2>\n<figure id=\"fold-paper\"><img id=\"fold-image\" src=\"/images/heart/step-01.svg\" alt=\"A square sheet ready to fold\" width=\"640\" height=\"420\"><figcaption id=\"fold-caption\">Choose a move below.</figcaption></figure>\n<div id=\"fold-choices\" aria-label=\"Choose a fold\"></div>\n<p><button type=\"button\" id=\"fold-hint\">Show hint</button> <button type=\"button\" id=\"fold-continue\" hidden>Next move</button> <button type=\"button\" id=\"fold-reset\">Restart game</button></p>\n<p id=\"fold-status\" role=\"status\"></p><p><a id=\"fold-tutorial\" href=\"/heart-tutorial\">Try this fold with real paper</a></p>\n</section><noscript><p>Enable JavaScript to play, or try a <a href=\"/tutorials\">paper-folding tutorial</a>.</p></noscript>\n<p><a href=\"/games\">Back to Games</a></p>",
  "styles": "#fold-quest [hidden]{display:none}#fold-paper{margin:1rem 0;background:white;border:2px solid #9cb8b3;border-radius:12px;padding:.75rem;text-align:center}#fold-image{display:block;max-width:100%;height:auto;max-height:420px;margin:auto;object-fit:contain}#fold-paper.is-target{border-color:#35645f;background:#e4f3eb}#fold-choices{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:.6rem}#fold-quest button{font:inherit;min-height:44px;padding:.65rem .85rem;border-radius:8px;border:1px solid #52736b;background:white;color:#18394a;cursor:pointer}#fold-quest button:hover:not(:disabled),#fold-continue{background:#d9eee3}#fold-quest button:focus-visible{outline:3px solid #903b65;outline-offset:3px}#fold-status{min-height:2em}",
  "scripts": [
    "js/fold-quest.js"
  ]
}
